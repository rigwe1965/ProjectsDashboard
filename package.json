{
  "name": "projects-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orchestration and showcase layer for independent apps. Never modifies them.",
  "scripts": {
    "status": "node supervisor/index.mjs status",
    "console": "node admin-console/server.mjs",
    "console:auth": "node admin-console/auth-cli.mjs",
    "gateway": "node demo-gateway/server.mjs",
    "demo": "node demo-gateway/grants-cli.mjs",
    "showcase:build": "node showcase/build.mjs",
    "showcase": "node showcase/build.mjs && node showcase/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "lint": "eslint .",
    "test:browser": "node tests/browser.mjs && node tests/browser-ui.mjs && node tests/browser-guide.mjs",
    "eval:guide": "node tests/guide-eval/run.mjs",
    "test:browser:guide": "node tests/browser-guide.mjs",
    "test:browser:ui": "node tests/browser-ui.mjs",
    "test:e2e": "node tests/journeys.mjs",
    "docs:book": "node docs/build-book.mjs",
    "backup": "node supervisor/backup-cli.mjs",
    "alert:test": "node supervisor/alert-cli.mjs",
    "migrate": "node supervisor/migrate.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "pg": "^8.23.1"
  }
}
