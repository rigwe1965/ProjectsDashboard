# Container recipe for the Remote Management (RMM) DEMO dashboard (Streamlit). Same rules as Dockerfile (this folder).
#   docker build -f deploy/apps/rmm/Dockerfile.ui -t pd-rmm-ui ../RemoteManagementSystem
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

WORKDIR /app
COPY dashboard/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY dashboard/ ./
# The app writes generated CSS to ./static at runtime and Streamlit keeps its config under $HOME; both are tmpfs in compose.
RUN useradd --create-home --uid 10001 app && mkdir -p /app/static && chown -R app /app
USER app

ENV PYTHONUNBUFFERED=1
EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
