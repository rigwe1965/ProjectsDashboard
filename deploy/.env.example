# Copy to deploy/.env and fill in. This file is read by docker compose; never commit the real one (it is git-ignored).

# Database password (any long random string; it is only used inside the compose network)
POSTGRES_PASSWORD=

# Three DNS names that point at this server (A/AAAA records). Wildcard for demos: *.DEMO_DOMAIN -> this server too.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
DEMO_DOMAIN=demo.example.com

# Contact address for the HTTPS certificate authority (expiry warnings)
ACME_EMAIL=you@example.com

# Optional: bearer token for GET /_pd/metrics (Prometheus). Leave empty to keep metrics private.
METRICS_TOKEN=

# Only for --profile apps: where the app folders are, relative to this deploy folder, and this repository's folder name
APPS_ROOT=../..
DASHBOARD_DIR=ProjectsDashboard
