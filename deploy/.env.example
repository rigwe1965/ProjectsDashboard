# Copy to deploy/.env and fill in. This file is read by docker compose; never commit the real one (it is git-ignored).

# Database password (any long random string; it is only used inside the compose network)
POSTGRES_PASSWORD=

# Three DNS names that point at this server (A/AAAA records). Wildcard for demos: *.DEMO_DOMAIN -> this server too.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
# REQUIRED (compose refuses to start without it). 64 hex characters that encrypt the admin 2-step secret in the database. Generate: npm run console:auth -- gen-key
ADMIN_DATA_KEY=
DEMO_DOMAIN=demo.example.com

# Contact address for the HTTPS certificate authority (expiry warnings)
ACME_EMAIL=you@example.com

# Optional: your booking page (an https address). Adds a "Book a call" link to the page a customer sees when they open a demo link. Leave empty for no link.
DEMO_BOOKING_URL=

# Optional: bearer token for GET /_pd/metrics (Prometheus). Leave empty to keep metrics private.
METRICS_TOKEN=

# Only for --profile apps: where the app folders are, relative to this deploy folder, and this repository's folder name
APPS_ROOT=../..
DASHBOARD_DIR=ProjectsDashboard

# Airfinder demo (only for --profile apps). Own secrets and own staff login for the demo: never reuse production values.
AIRFINDER_SECRET_KEY=
AIRFINDER_JWT_SECRET=
AIRFINDER_ADMIN_EMAIL=demo@example.com
AIRFINDER_ADMIN_PASSWORD=

# CRM demo (only for --profile apps). Its own Postgres inside the compose network. Use letters and digits only in passwords.
CRM_DB_PASSWORD=
CRM_APP_PASSWORD=
# The running CRM's second login (sign-in and daily jobs: row-level security bypassed, no schema changes). Created by the crm-migrate step.
CRM_PLATFORM_PASSWORD=
CRM_AUTH_SECRET=
# Password for the seeded demo users (admin@crm.test, sales@crm.test, support@crm.test)
CRM_DEMO_PASSWORD=

# ClaudeWorkspace (CarRental) demo (only for --profile apps). A SEPARATE, empty Supabase project made just for demos:
# NEVER the production project's keys. Supabase dashboard > Project Settings > API.
CW_SUPABASE_URL=
# The demo project's ref (the first part of its URL). The reset refuses to empty any project but this one.
CW_DEMO_PROJECT_REF=
CW_SUPABASE_ANON_KEY=
CW_SUPABASE_SERVICE_ROLE_KEY=
# The two demo sign-ins in that Supabase project. reset-demos.sh keeps these accounts, removes every other one, and sets their
# passwords back to these values.
CW_DEMO_ADMIN_EMAIL=
CW_DEMO_ADMIN_PASSWORD=
CW_DEMO_CUSTOMER_EMAIL=
CW_DEMO_CUSTOMER_PASSWORD=

# ClaudeOS demo (only for --profile apps). Its own database; no mail, no cloud sync. Never reuse production values.
# Secret key: at least 32 random characters. Demo password: the login "demo" in the demo (10+ characters with upper, lower and a digit; it must not contain the word "demo").
CLAUDEOS_SECRET_KEY=
CLAUDEOS_DEMO_PASSWORD=
# REQUIRED: an Anthropic key (the ClaudeOS API refuses to start without one). Every demo visitor's AI action costs you money:
# use a key with a spend limit, not your main key.
CLAUDEOS_ANTHROPIC_API_KEY=

# Remote Management (RMM) demo (only for --profile apps). Its own Postgres and Redis; every customer, device and ticket is simulated.
# Use letters and digits only in the two passwords (they sit inside connection addresses). Secrets: long random values.
RMM_DB_PASSWORD=
RMM_REDIS_PASSWORD=
RMM_SECRET_KEY=
RMM_JWT_SECRET_KEY=
RMM_ORG_TOKEN=
# A hidden owner login inside the demo (10+ characters). Never give it to a visitor.
RMM_SUPERADMIN_PASSWORD=
# The sign-in you give visitors (email defaults to admin@rmm-demo.test).
RMM_DEMO_ADMIN_EMAIL=admin@rmm-demo.test
RMM_DEMO_ADMIN_PASSWORD=
# Optional AI assistant: set a key with a spend limit AND RMM_AI_ENABLED=1. Off by default.
RMM_ANTHROPIC_API_KEY=
RMM_AI_ENABLED=0

# Console Start/Stop/Restart/Log buttons: a long random value (openssl rand -hex 32), also written to /etc/pd-ctl.env for the host helper (deploy/ctl). Empty = buttons stay off.
PD_CTL_TOKEN=
