{
  "_note": "Registry of independent apps. The dashboard only READS app folders. Ports are dashboard-managed (never 3000, which belongs to an unrelated RMM process). Placeholders: {port} = this process's port, {url} = http://localhost:{port}, {port:NAME} = sibling process port. cwd is relative to the app path. Env values are set on the child process only; no app file is modified. Entries with demoOf are customer-demo instances; the gateway only serves them when demoReady is true, which you must set only after confirming the instance shares no data with production.",
  "reservedPorts": [
    3000,
    5000,
    8501
  ],
  "apps": [
    {
      "id": "airfinder",
      "name": "Airfinder",
      "tagline": "Search for cheap air tickets",
      "path": "C:\\Users\\rigwe\\Desktop\\Airfinder",
      "stack": "Flask + SQLite/Postgres",
      "processes": [
        {
          "name": "app",
          "cmd": "python run.py",
          "cwd": ".",
          "port": 5200,
          "health": "/",
          "env": {
            "PORT": "{port}"
          }
        }
      ],
      "demo": {
        "supported": true,
        "notes": "Separate DATABASE_URL; seed_demo.py exists"
      }
    },
    {
